{
  "name": "examples-monorepo-deploy",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "description": "Turborepo monorepo that checks what the deployer puts in a deploy artifact for workspace packages",
  "scripts": {
    "build:linked-workspace-deps": "turbo --cwd ../.. build --filter mastra",
    "build": "turbo build",
    "verify": "node scripts/verify.mjs",
    "clean": "rm -rf apps/*/.mastra"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "turbo": "^2.9.12",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@mastra/core": "link:../../packages/core",
      "@mastra/deployer": "link:../../packages/deployer",
      "mastra": "link:../../packages/cli"
    }
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.29.3+sha512.498e1fb4cca5aa06c1dcf2611e6fafc50972ffe7189998c409e90de74566444298ffe43e6cd2acdc775ba1aa7cc5e092a8b7054c811ba8c5770f84693d33d2dc"
}
